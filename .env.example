# Copy this file to .env and fill in the values before running the app.

# Required: Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: set to "true" to enable Flask debug mode (never use in production)
FLASK_DEBUG=false

# Optional: path where contact form submissions are appended (default: contact_submissions.log)
CONTACT_LOG=contact_submissions.log
